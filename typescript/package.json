{
  "name": "@rtemis/draw",
  "version": "0.9.1",
  "description": "ECharts option builders shared by rtemis.draw and rtemislive",
  "homepage": "https://rtemis.org",
  "keywords": [
    "rtemis",
    "echarts",
    "visualization"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/rtemis-org/draw",
    "directory": "typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && pnpm bundle",
    "bundle": "esbuild src/index.ts --bundle --format=iife --global-name=RtemisDraw --target=es2020 --legal-comments=inline --footer:js=\"if (typeof module === 'object' && module.exports) module.exports = RtemisDraw;\" --outfile=dist/rtemis-draw-builders.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm typecheck && pnpm check && vitest run",
    "check": "biome check src tests",
    "fix": "biome check --write src tests",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@rtemis/a3": ">=0.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rtemis/a3": "^0.3.2",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^25.9.5",
    "@types/topojson-client": "^3.1.5",
    "d3-scale-chromatic": "3.1.0",
    "esbuild": "^0.25.0",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout": "0.6.1",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "topojson-client": "3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
